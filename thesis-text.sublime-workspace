			"contents": "%& -shell-escape\n% !TeX root = thesis-text.tex\n% !TeX encoding = UTF-8\n% !TeX program = XeLaTeX\n\n\\documentclass{.local/lib/classes/ndvr-super-article-standalone}\n\n\\title[NDVR thesis-abstract]{%\n    Области применения поиска нечетких дубликатов видео%\n}\n\n\\begin{document}\n\n    \\section{Области применения поиска нечетких дубликатов видео}\n\n    \\begin{shiftdownsection}\n        \\relimport{reranking}\n        \\relimport{recommendations}\n        \\relimport{news-thread-tracking}\n\n        \\relimport{copyright}\n        \\relimport{monitoring}\n        \\relimport{cctv}\n\n    \\end{shiftdownsection}\n\n\\end{document}\n\n",
