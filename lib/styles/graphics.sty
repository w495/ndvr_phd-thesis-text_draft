\newcommand{\tikzXmindmap}[1]{
    \sf
    \begin{tikzpicture}[very thick, scale=.93,
            concept color=vlgray,
            every node/.style={scale=.93},
            outer sep=1pt
        ]#1
        \begin{scope}[
            on background layer,
            scale=1.0,
            every node/.style={scale=1.0},
            concept color=black!80
        ]#1\end{scope}
    \end{tikzpicture}
}


\newcommand{\tikzXmindmapTitle}[1]{
    \sf
    \begin{tikzpicture}[very thick, scale=.30,
            concept color=white,
            every node/.style={scale=.30},
            outer sep=2pt
        ]#1
        \begin{scope}[
            on background layer,
            scale=1.0,
            every node/.style={scale=0.35},
            concept color=red
        ]#1\end{scope}
    \end{tikzpicture}
}
