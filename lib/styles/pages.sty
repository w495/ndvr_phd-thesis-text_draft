%%%
%%% импользование onehalfspacing --- полуторного интервала
%%%

\usepackage{setspace}
\singlespacing

%%%
%%% отступы параграфов
%%%

%\usepackage{indentfirst}
%\setlength{\parindent}{-1.5em}

\setlength{\parskip}{0.5ex plus 2.5ex minus 1.2ex}


%%%
%%% Делаем номер станиц не выделяемыми.
%%%
\usepackage{fancyhdr}

\newcommand{\headname}[1]{#1}
\newcommand{\footname}[1]{#1}


\usepackage{accsupp}

\newcommand\squelch[1]{%
    \BeginAccSupp{method=plain,ActualText={}}#1\EndAccSupp{}%
}

\fancypagestyle{plain}{%
    \fancyhf{}%
    \fancyhead[C]{\squelch{\headname{\thepage}}}
    \fancyfoot[C]{\squelch{\footname{\thepage}}}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0pt}%
}
\pagestyle{plain}


%%%
%%% отступы от края страницы
%%%
\usepackage[top=2.0cm, bottom=2.0cm, left=2.5cm, right=1.5cm]{geometry}


%%%
%%% водяной знак
%%%


\usepackage{draftwatermark}

\SetWatermarkAngle{90}
\SetWatermarkLightness{0.67}
\SetWatermarkFontSize{0.3cm}
\SetWatermarkScale{1}
\SetWatermarkHorCenter{1.5cm}


\makeatletter
    \renewenvironment{titlepage}{%
        \if@twocolumn
            \@restonecoltrue\onecolumn
        \else
            \@restonecolfalse\newpage
        \fi
        \thispagestyle{empty}% remove the empty page style
    }%
\makeatother
