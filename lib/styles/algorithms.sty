\usepackage[ruled,section]{.local/lib/styles/algorithms/algorithm}
\usepackage[noend]{.local/lib/styles/algorithms/algorithmic}

\newcommand{\rusbf}[1]{
    \textcolor{blue}{\textbf{#1}}
}

\newcommand{\realgorithmic}{
    \renewcommand{\algorithmicrequire}{\rusbf{Нужно:}}
    \renewcommand{\algorithmicensure}{\rusbf{Есть:}}
    \renewcommand{\algorithmicend}{\rusbf{Конец}}
    \renewcommand{\algorithmicif}{\rusbf{Если}}
    \renewcommand{\algorithmicthen}{\rusbf{то}}
    \renewcommand{\algorithmicelse}{\rusbf{иначе}}
    \renewcommand{\algorithmicelsif}{\algorithmicelse\ \algorithmicif}
    \renewcommand{\algorithmicendif}{\algorithmicend\ \algorithmicif}
    \renewcommand{\algorithmicfor}{\rusbf{Для}}
