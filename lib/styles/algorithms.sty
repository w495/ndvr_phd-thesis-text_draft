    \renewcommand{\algorithmicwhile}{\rusbf{Пока}}
    \renewcommand{\algorithmicendwhile}{\algorithmicend\ \algorithmicwhile}
    \renewcommand{\algorithmicloop}{\rusbf{Цикл}}
    \renewcommand{\algorithmicendloop}{\algorithmicend\ \algorithmicloop}
    \renewcommand{\algorithmicrepeat}{\rusbf{Повторить}}
    \renewcommand{\algorithmicuntil}{\rusbf{До тех пор пока}}
 }


